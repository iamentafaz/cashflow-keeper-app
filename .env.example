# Supabase project URL, exposed to the browser by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key only. Never put the service_role key in this file.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Canonical production URL used for Supabase Auth email callbacks.
NEXT_PUBLIC_SITE_URL=https://app.example.com
